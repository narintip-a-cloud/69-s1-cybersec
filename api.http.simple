##################################################
# CONFIG (แก้ค่าให้ตรงกับ .env ของตัวเอง)
# MailHog UI: http://localhost:8025  (ดูอีเมล reset password)
# pgAdmin    : http://localhost:8081
##################################################
@baseUrl = http://localhost:9091
@adminEmail = ""
@adminPassword = ""
@userUsername = ""
@userEmail = ""
@userPassword = ""

##################################################
# 1. ADMIN OPERATIONS
# JWT ของ admin ใช้ได้กับ /admin/* เท่านั้น ห้ามเอาไปยิง /api/*
##################################################

### 1. Register Admin (ทำได้ครั้งเดียว ถ้ามี super admin อยู่แล้วจะได้ 400)
POST {{baseUrl}}/admin/register-admin
Content-Type: application/json

{
    "firstname": "",
    "lastname": "",
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}",
    "registrationToken": ""
}

### 2. Login Admin
# @name adminLogin
# ยิงซ้ำ ๆ ติด ๆ จะได้ 429 (rate limit) ต้องรอสักพักก่อนลองใหม่
POST {{baseUrl}}/admin/login
Content-Type: application/json

{
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
}

### 3. Forgot Password Admin (เปิด MailHog เพื่อเอา code)
POST {{baseUrl}}/admin/forgot-password
Content-Type: application/json

{
    "email": "{{adminEmail}}"
}

### 4. Reset Password Admin (field คือ resetPasswordToken ไม่ใช่ code)
POST {{baseUrl}}/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "",
    "password": "{{adminPassword}}"
}

### 5. Profile Admin
GET {{baseUrl}}/admin/users/me
Authorization: Bearer {{adminLogin.response.body.data.token}}

### 6. List Admin Users
GET {{baseUrl}}/admin/users
Authorization: Bearer {{adminLogin.response.body.data.token}}

##################################################
# 2. USER OPERATIONS
##################################################

### 1. Register User
POST {{baseUrl}}/api/auth/local/register
Content-Type: application/json

{
    "username": "{{userUsername}}",
    "email": "{{userEmail}}",
    "password": "{{userPassword}}"
}

### 2. Login User
# @name userLogin
POST {{baseUrl}}/api/auth/local
Content-Type: application/json

{
    "identifier": "{{userEmail}}",
    "password": "{{userPassword}}"
}

### 3. Forgot Password User (เปิด MailHog เพื่อเอา code)
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{userEmail}}"
}

### 4. Reset Password User (ต้องมี passwordConfirmation ด้วย)
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
    "code": "",
    "password": "{{userPassword}}",
    "passwordConfirmation": "{{userPassword}}"
}

### 5. Profile User
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{userLogin.response.body.jwt}}

### Update Profile User
# ยังใช้ไม่ได้ครับ ได้ 403 เพราะ role "Authenticated" ยังไม่มี permission
# plugin::users-permissions.user.update (และไม่มี action นี้ในรายการ permission ของระบบ)
# ต้องไปเปิดที่ Settings > Users & Permissions > Roles > Authenticated ก่อน
# PUT {{baseUrl}}/api/users/me
# Content-Type: application/json
# Authorization: Bearer {{userLogin.response.body.jwt}}
#
# {
#     "username": "{{userUsername}}"
# }

##################################################
# 3. API TOKEN
# /api/<content-type> ใช้ API Token เท่านั้น (JWT ของ admin/user ใช้ไม่ได้ -> 401)
# สร้างครั้งเดียวแล้วเก็บ accessKey ไว้ ค่า accessKey จะโชว์ครั้งเดียวเท่านั้น
##################################################

### 1. Create API Token (full-access)
# @name createApiToken
POST {{baseUrl}}/admin/api-tokens
Content-Type: application/json
Authorization: Bearer {{adminLogin.response.body.data.token}}

{
    "name": "api-http",
    "description": "token for api.http",
    "type": "full-access"
}

### 2. List API Tokens (ไม่คืนค่า accessKey)
GET {{baseUrl}}/admin/api-tokens
Authorization: Bearer {{adminLogin.response.body.data.token}}

##################################################
# 4. CONTENT TYPES
# ทุก request ในหัวข้อนี้ต้องมี Authorization: Bearer <apiKey>
# ตัวอย่างนี้ใช้ {{createApiToken.response.body.data.accessKey}}
# ถ้า Public/Authenticated role ยังไม่ได้เปิด permission
# ให้ไปเปิดที่ Settings > Users & Permissions > Roles ก่อน
##################################################

### SUBJECT

#### 1. Create Subject
# @name createSubject
POST {{baseUrl}}/api/subjects
Content-Type: application/json
Authorization: Bearer {{createApiToken.response.body.data.accessKey}}

{
    "data": {
        "name": "Cyber Security"
    }
}

#### 2. List Subjects (filters + pagination)
GET {{baseUrl}}/api/subjects?pagination[pageSize]=10&pagination[page]=1&sort=name:asc
Authorization: Bearer {{createApiToken.response.body.data.accessKey}}

#### 3. Get Subject
GET {{baseUrl}}/api/subjects/1
Authorization: Bearer {{createApiToken.response.body.data.accessKey}}

#### 4. Update Subject
PUT {{baseUrl}}/api/subjects/1
Content-Type: application/json
Authorization: Bearer {{createApiToken.response.body.data.accessKey}}

{
    "data": {
        "name": "Cyber Security 101"
    }
}

#### 5. Delete Subject
DELETE {{baseUrl}}/api/subjects/1
Authorization: Bearer {{createApiToken.response.body.data.accessKey}}

### TEACHER

#### 1. Create Teacher
# @name createTeacher
POST {{baseUrl}}/api/teachers
Content-Type: application/json
Authorization: Bearer {{createApiToken.response.body.data.accessKey}}

{
    "data": {
        "name": "Dr. Somchai"
    }
}

#### 2. List Teachers
GET {{baseUrl}}/api/teachers?filters[name][$eq]=Dr. Somchai
Authorization: Bearer {{createApiToken.response.body.data.accessKey}}

#### 3. Get Teacher
GET {{baseUrl}}/api/teachers/1
Authorization: Bearer {{createApiToken.response.body.data.accessKey}}

#### 4. Update Teacher
PUT {{baseUrl}}/api/teachers/1
Content-Type: application/json
Authorization: Bearer {{createApiToken.response.body.data.accessKey}}

{
    "data": {
        "name": "Asst. Prof. Somchai"
    }
}

#### 5. Delete Teacher
DELETE {{baseUrl}}/api/teachers/1
Authorization: Bearer {{createApiToken.response.body.data.accessKey}}

### MAPPING (teacher 1 : subjects many)

#### 1. Create Mapping (subjects ต้องมีอยู่จริง ไม่งั้น 400)
# @name createMapping
POST {{baseUrl}}/api/mappings
Content-Type: application/json
Authorization: Bearer {{createApiToken.response.body.data.accessKey}}

{
    "data": {
        "teacher": 1,
        "subjects": [1, 2]
    }
}

#### 2. List Mappings (populate relation)
GET {{baseUrl}}/api/mappings?populate=*
Authorization: Bearer {{createApiToken.response.body.data.accessKey}}

#### 3. Update Mapping
PUT {{baseUrl}}/api/mappings/1
Content-Type: application/json
Authorization: Bearer {{createApiToken.response.body.data.accessKey}}

{
    "data": {
        "teacher": 1,
        "subjects": [1]
    }
}

#### 4. Delete Mapping
DELETE {{baseUrl}}/api/mappings/1
Authorization: Bearer {{createApiToken.response.body.data.accessKey}}

### STUDENT (mobile ถูก hash ด้วย md5 ใน lifecycle ตอน create)

#### 1. Create Student (mobile ต้องครบ 10 หลัก และ cardId ครบ 13 หลัก)
# @name createStudent
POST {{baseUrl}}/api/students
Content-Type: application/json
Authorization: Bearer {{createApiToken.response.body.data.accessKey}}

{
    "data": {
        "name": "Somchai",
        "mobile": "0812345678",
        "cardId": "1234567890123"
    }
}

#### 2. List Students
GET {{baseUrl}}/api/students
Authorization: Bearer {{createApiToken.response.body.data.accessKey}}

#### 3. Get Student
GET {{baseUrl}}/api/students/1
Authorization: Bearer {{createApiToken.response.body.data.accessKey}}

#### 4. Update Student (beforeCreate เท่านั้นที่ hash mobile การ update จะไม่ถูก hash)
PUT {{baseUrl}}/api/students/1
Content-Type: application/json
Authorization: Bearer {{createApiToken.response.body.data.accessKey}}

{
    "data": {
        "name": "Somchai Edited"
    }
}

#### 5. Delete Student
DELETE {{baseUrl}}/api/students/1
Authorization: Bearer {{createApiToken.response.body.data.accessKey}}
